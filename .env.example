# Copy to .env.local for local development. Never commit real values.

# Supabase → Project Settings → API (the "publishable" key also works here)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Bypasses RLS — used only by the review submit action.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Turnstile. These are Cloudflare's official always-pass TEST keys for development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Random string (32+ chars) used to salt device/IP hashes for review anti-spam.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HASH_SALT=change-me-to-a-long-random-string

# Public site URL, no trailing slash (production: https://solen.ge)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
